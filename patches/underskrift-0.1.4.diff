 //! Handles `/DocMDP` transform method for certification signatures and
 //! `/FieldMDP` for field-level locking.
 
+use lopdf::{Dictionary, Document, Object, ObjectId};
+
+use crate::error::CoreError;
+
 /// Permitted changes level for a certification signature (DocMDP).
 #[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
 pub enum DocMdpPermissions {
@@ -14,3 +18,113 @@
     /// Form filling, signing, and annotation
     FormFillingSigningAndAnnotation = 3,
 }
+
+/// Builds the `/Reference` array for a certification signature.
+///
+/// Goes into the signature dictionary and declares that this signature is a
+/// certification (author) signature rather than an ordinary approval one:
+///
+/// ```text
+/// /Reference [ << /Type /SigRef
+///                 /TransformMethod /DocMDP
+///                 /TransformParams << /Type /TransformParams /V /1.2 /P n >> >> ]
+/// ```
+///
+/// Per ISO 32000-1 §12.8.2.2, `/V` is the DocMDP transform parameters version
+/// and is always `1.2`.
+pub fn build_sig_reference(permissions: DocMdpPermissions) -> Object {
+    let mut params = Dictionary::new();
+    params.set("Type", Object::Name(b"TransformParams".to_vec()));
+    params.set("V", Object::Name(b"1.2".to_vec()));
+    params.set("P", Object::Integer(permissions as i64));
+
+    let mut sig_ref = Dictionary::new();
+    sig_ref.set("Type", Object::Name(b"SigRef".to_vec()));
+    sig_ref.set("TransformMethod", Object::Name(b"DocMDP".to_vec()));
+    sig_ref.set("TransformParams", Object::Dictionary(params));
+
+    Object::Array(vec![Object::Dictionary(sig_ref)])
+}
+
+/// Points the document catalog's `/Perms` at the certification signature.
+///
+/// A document may carry only one certification signature, and it must be the
+/// first one applied (ISO 32000-1 §12.8.2.2). If `/Perms /DocMDP` is already
+/// present, the document is already certified and this fails rather than
+/// silently producing a file that readers will flag.
+pub fn set_perms_doc_mdp(doc: &mut Document, sig_dict_id: ObjectId) -> Result<(), CoreError> {
+    let catalog_id = doc
+        .trailer
+        .get(b"Root")
+        .and_then(Object::as_reference)
+        .map_err(|_| CoreError::InvalidStructure("trailer missing /Root reference".into()))?;
+
+    let catalog = doc
+        .get_object_mut(catalog_id)
+        .map_err(|e| CoreError::InvalidStructure(format!("failed to get catalog: {e}")))?
+        .as_dict_mut()
+        .map_err(|e| CoreError::InvalidStructure(format!("catalog is not a dictionary: {e}")))?;
+
+    let already_certified = catalog
+        .get(b"Perms")
+        .ok()
+        .and_then(|p| p.as_dict().ok())
+        .is_some_and(|perms| perms.has(b"DocMDP"));
+
+    if already_certified {
+        return Err(CoreError::InvalidStructure(
+            "document already carries a certification signature; only one is permitted".into(),
+        ));
+    }
+
+    let mut perms = match catalog.get(b"Perms") {
+        Ok(Object::Dictionary(d)) => d.clone(),
+        _ => Dictionary::new(),
+    };
+    perms.set("DocMDP", Object::Reference(sig_dict_id));
+    catalog.set("Perms", Object::Dictionary(perms));
+
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn sig_reference_carries_the_permission_level() {
+        let Object::Array(items) = build_sig_reference(DocMdpPermissions::NoChanges) else {
+            panic!("expected an array");
+        };
+        let sig_ref = items[0].as_dict().unwrap();
+        assert_eq!(
+            sig_ref.get(b"TransformMethod").unwrap().as_name().unwrap(),
+            b"DocMDP"
+        );
+        let params = sig_ref
+            .get(b"TransformParams")
+            .unwrap()
+            .as_dict()
+            .unwrap();
+        assert_eq!(params.get(b"V").unwrap().as_name().unwrap(), b"1.2");
+        assert_eq!(params.get(b"P").unwrap().as_i64().unwrap(), 1);
+    }
+
+    #[test]
+    fn permission_levels_map_to_the_pdf_p_values() {
+        assert_eq!(DocMdpPermissions::NoChanges as i64, 1);
+        assert_eq!(DocMdpPermissions::FormFillingAndSigning as i64, 2);
+        assert_eq!(DocMdpPermissions::FormFillingSigningAndAnnotation as i64, 3);
+    }
+
+    #[test]
+    fn refuses_to_certify_an_already_certified_document() {
+        let mut doc = Document::with_version("1.7");
+        let catalog_id = doc.add_object(Object::Dictionary(Dictionary::new()));
+        doc.trailer.set("Root", Object::Reference(catalog_id));
+        let sig_id = doc.add_object(Object::Dictionary(Dictionary::new()));
+
+        set_perms_doc_mdp(&mut doc, sig_id).expect("first certification should succeed");
+        assert!(set_perms_doc_mdp(&mut doc, sig_id).is_err());
+    }
+}
