@@ -1458,4 +1475,120 @@ mod image_tests {
         assert_eq!(result.image_resources.len(), 1);
         assert!(!result.font_resources.is_empty());
     }
+
+    /// A custom renderer that paints a picture.
+    ///
+    /// Text it could always lay out freely; an image it could not carry at
+    /// all, so any appearance mixing a scan with text had to go through one of
+    /// the fixed `Arrangement`s.
+    #[cfg(feature = "visual")]
+    struct PictureRenderer {
+        data: Vec<u8>,
+    }
+
+    #[cfg(feature = "visual")]
+    impl AppearanceRenderer for PictureRenderer {
+        fn render(&self, ctx: &AppearanceContext) -> Result<CustomAppearanceResult, VisualError> {
+            let mut content = Vec::new();
+            write_fmt(
+                &mut content,
+                &format!("{:.2} 0 0 {:.2} 0 0 cm", ctx.width, ctx.height),
+            );
+            write_op(&mut content, "/Im1 Do");
+
+            Ok(CustomAppearanceResult {
+                content,
+                image_resources: vec![(
+                    "Im1".to_string(),
+                    ImageConfig {
+                        data: self.data.clone(),
+                        format: ImageFormat::Jpeg,
+                        scale: ImageScale::FitPreserveAspect,
+                    },
+                )],
+                ..Default::default()
+            })
+        }
+    }
+
+    /// The image a custom renderer asks for has to reach the appearance, or
+    /// the signer pipeline has no XObject to build and `/Im1 Do` paints
+    /// nothing.
+    #[cfg(feature = "visual")]
+    #[test]
+    fn test_custom_appearance_carries_its_images() {
+        let renderer = PictureRenderer {
+            data: test_jpeg_bytes(),
+        };
+
+        let result =
+            build_custom_appearance(&renderer, &test_context(), 200.0, 80.0, None, None).unwrap();
+
+        assert_eq!(result.image_resources.len(), 1);
+        assert_eq!(result.image_resources[0].resource_name, "Im1");
+        assert_eq!(result.image_resources[0].image.width, 10);
+        assert!(String::from_utf8_lossy(&result.content).contains("/Im1 Do"));
+    }
+
+    /// A renderer that asks for nothing must still come out with nothing,
+    /// rather than an empty XObject the pipeline would have to skip.
+    #[cfg(feature = "visual")]
+    #[test]
+    fn test_custom_appearance_without_images_has_none() {
+        struct TextOnly;
+        impl AppearanceRenderer for TextOnly {
+            fn render(&self, _ctx: &AppearanceContext) -> Result<CustomAppearanceResult, VisualError> {
+                Ok(CustomAppearanceResult {
+                    content: b"q Q\n".to_vec(),
+                    ..Default::default()
+                })
+            }
+        }
+
+        let result =
+            build_custom_appearance(&TextOnly, &test_context(), 100.0, 40.0, None, None).unwrap();
+
+        assert!(result.image_resources.is_empty());
+    }
+
+    /// Bytes that are not the format they claim have to fail here, where the
+    /// caller can still be told which resource was wrong — not later, in the
+    /// middle of writing a PDF.
+    #[cfg(feature = "visual")]
+    #[test]
+    fn test_custom_appearance_rejects_an_unreadable_image() {
+        struct Broken;
+        impl AppearanceRenderer for Broken {
+            fn render(&self, _ctx: &AppearanceContext) -> Result<CustomAppearanceResult, VisualError> {
+                Ok(CustomAppearanceResult {
+                    image_resources: vec![(
+                        "Im1".to_string(),
+                        ImageConfig {
+                            data: b"not a jpeg".to_vec(),
+                            format: ImageFormat::Jpeg,
+                            scale: ImageScale::FitPreserveAspect,
+                        },
+                    )],
+                    ..Default::default()
+                })
+            }
+        }
+
+        assert!(build_custom_appearance(&Broken, &test_context(), 100.0, 40.0, None, None).is_err());
+    }
+
+    /// A context with nothing in it: these tests are about resources, not
+    /// about what the renderer does with the signing metadata.
+    #[cfg(feature = "visual")]
+    fn test_context() -> AppearanceContext {
+        AppearanceContext {
+            width: 0.0,
+            height: 0.0,
+            signer_name: None,
+            reason: None,
+            location: None,
+            date: None,
+            contact_info: None,
+        }
+    }
 }
